  const lv=getLevel(points);
  document.getElementById('level-icon').textContent=lv.icon;
  document.getElementById('level-name').textContent=lv.name;
  const toNext=Math.max(0,lv.next-points);
  document.getElementById('level-sub').textContent='Noch '+toNext+' XP bis zum nächsten Level';
  const prog=Math.min(100,((points-lv.min)/(lv.next-lv.min))*100);
  document.getElementById('level-bar').style.width=prog+'%';
  document.getElementById('streak-msg').textContent=streak===0?'Starte heute!':streak<3?'Weiter! '+streak+' Tage':streak<7?'🔥 '+streak+' Tage Streak!':'🏆 '+streak+' Tage – Legendär!';
  const days=['mo','di','mi','do','fr','sa','so'];
  const dm={0:6,1:0,2:1,3:2,4:3,5:4,6:5};
  const ti=dm[new Date().getDay()]??0;
  days.forEach((d,i)=>{
    const el=document.getElementById('gwd-'+d);if(!el) return;
    const date=getWeekDate(i);
    if(weekDone[date]){el.classList.add('done');el.classList.remove('today')}
    else if(i===ti){el.classList.add('today');el.classList.remove('done')}
