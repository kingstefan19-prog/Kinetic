}

function getWeekDate(idx){
  const now=new Date();const dm={0:6,1:0,2:1,3:2,4:3,5:4,6:5};
  const ti=dm[now.getDay()]??0;const d=new Date(now);
  d.setDate(now.getDate()-(ti-idx));return d.toISOString().split('T')[0];
}

