function renderPlan(){
  ['mo','mi','do'].forEach(day=>{
    const exList = planState?.[day] || DEFAULT_PLAN[day];
    const container = document.getElementById('exlist-'+day);
    if(!container) return;

    container.innerHTML = exList.map((ex,i)=>{
      const hist = exHist[ex.name];
      const hasSuggestion = hist && hist.length > 0;
      const isBanned = bannedEx.includes(ex.name);
      return `
        <div class="er" id="ex-${day}-${i}">
          <div class="er-left">
            <div class="en">${ex.name}${isBanned ? ' <span style="color:var(--accent);font-size:10px">⚠</span>' : ''}</div>
            <div class="eno">${ex.note}</div>
            ${hasSuggestion ? `<div style="font-size:10px;color:var(--green);margin-top:3px">📊 ${hist.length} Session${hist.length>1?'s':''} geloggt · E1RM: ~${Math.round(e1rm(hist[hist.length-1].weight,hist[hist.length-1].reps))} kg</div>` : ''}
          </div>
          <div class="er-right">
            <div class="es">${ex.sets}</div>
            <button class="replace-btn" onclick="openReplaceModal('${day}',${i},'${ex.name}')">↔ Ersetzen</button>
          </div>
        </div>`;
    }).join('');

    // FEATURE 2: Weight suggestions
    renderSuggestions(day, exList);
  });

  // Render banned list
  renderBanned();
}

function renderSuggestions(day, exList){
  const container = document.getElementById('suggestions-'+day);
  if(!container) return;
  const suggestions = [];

  exList.forEach(ex => {
    const hist = exHist[ex.name];
    if(!hist || hist.length===0) return;
    const parts = ex.sets.match(/(\d+)–(\d+)/);
    const tMin = parts ? parseInt(parts[1]) : 6;
    const tMax = parts ? parseInt(parts[2]) : 8;
    const last = hist[hist.length-1];
    const next = calcNext(hist, tMin, tMax, last.rpe||8);
    if(next.nextWeight) {
      suggestions.push({ex:ex.name, w:next.nextWeight, r:next.nextReps, sessions:hist.length});
    }
  });

  if(!suggestions.length){container.innerHTML='';return;}

  container.innerHTML = suggestions.map(s=>`
    <div class="suggestion-pill">
      <span class="sp-icon">💡</span>
      <div class="sp-text">
        <strong>${s.ex}</strong>
        Vorgeschlagen: ${s.w} kg × ${s.r} Wdh (aus ${s.sessions} Session${s.sessions>1?'s':''})
      </div>
      <button class="sp-btn" onclick="applyWeightSuggestion('${s.ex}',${s.w},${s.r})">Übernehmen</button>
    </div>`).join('');
}

function applyWeightSuggestion(exName, weight, reps){
  // Find which day this exercise belongs to and start full session
  let targetDay = 'mo';
  ['mo','mi','do'].forEach(d => {
    const plan = planState?.[d] || DEFAULT_PLAN[d];
    if(plan.some(e => e.name === exName)) targetDay = d;
  });
  openLog(targetDay, exName, 4, `${reps}–${reps+2}`);
  // Pre-fill suggestion into first set after render
  setTimeout(() => {
    if(activeSession && activeSession.logs[exName]) {
      activeSession.logs[exName][0].kg = weight;
      activeSession.logs[exName][0].reps = reps;
      DB.set('activeWS', activeSession);
      renderWSSets(exName, activeSession.logs[exName].length);
      showToast(`💡 ${weight} kg × ${reps} Wdh vorausgefüllt`);
    }
  }, 300);
}

