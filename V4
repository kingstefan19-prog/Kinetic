function e1rm(w,r){return r===1?w:w/(1.0278-0.0278*r)}

function calcNext(hist,tMin,tMax,rpe){
  if(!hist||!hist.length) return{nextWeight:null,nextReps:tMin,note:'Kalibrierungsphase.'};
  const last=hist[hist.length-1];
  const w=last.weight,r=last.reps;

  // FEATURE 4: Nutrition impact on progression
  const impact=computeNutritionImpact();
  const aggressiveBonus = impact?.type==='surplus' ? 1 : 0;
  const volumePenalty   = impact?.type==='deficit';

  if(rpe>=9) return{nextWeight:w,nextReps:Math.max(r-1,tMin),e1rmVal:e1rm(w,r),deloadSignal:true,note:'⚠️ RPE '+rpe+' – kein Fortschritt.'};
  if(volumePenalty && rpe>=8) return{nextWeight:w,nextReps:r,e1rmVal:e1rm(w,r),note:'📉 Kaloriendefizit erkannt – Volumen stabil gehalten.'};

  if(r>=tMax){
    const inc=w>=80?2.5:1.25;
    return{nextWeight:w+inc,nextReps:tMin,e1rmVal:e1rm(w,r),note:`✅ Gewicht +${inc} kg (Surplus-Bonus: ${aggressiveBonus>0?'+1 Rep':''}).`};
  }
  const rj=Math.min(2,(rpe<=6?2:1)+aggressiveBonus);
  return{nextWeight:w,nextReps:Math.min(r+rj,tMax),e1rmVal:e1rm(w,r),note:`📈 Reps +${rj} (RPE ${rpe}${aggressiveBonus?', Surplus-Boost':''}).`};
}

function checkDeload(hist){
  const last2=(hist||[]).slice(-2);
  const highRPE=last2.length>=2&&last2.every(s=>s.rpe>=9);
  const recent=fatLog.slice(-3);
  const avg=recent.length?recent.reduce((a,b)=>a+b,0)/recent.length:0;
  const nutrImpact=computeNutritionImpact();
  const nutrDeload=nutrImpact?.type==='deficit'&&nutrImpact.volumeMod<=-0.2;
  if(highRPE||avg>=4||nutrDeload) return{
    deload:true,
    reason:nutrDeload?'Anhaltender Kaloriendefizit erkannt.':highRPE?'RPE ≥ 9 × 2 Sessions.':'Ø Fatigue '+avg.toFixed(1)+' ≥ 4.'
  };
  return{deload:false};
}

