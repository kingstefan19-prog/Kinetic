function computeWeeklyVolume() {
  // Count sets logged this week per muscle
  const weekStart = new Date();
  weekStart.setDate(weekStart.getDate() - weekStart.getDay() + (weekStart.getDay()===0?-6:1));
  weekStart.setHours(0,0,0,0);
  const volumes = {};
  Object.entries(exHist).forEach(([exName, sessions]) => {
    const muscle = EX_MUSCLE_MAP[exName];
    if(!muscle) return;
    sessions.forEach(s => {
      if(new Date(s.date) >= weekStart) {
        volumes[muscle] = (volumes[muscle]||0) + 1; // count as 1 set per logged entry (approximation)
      }
    });
  });
  // Better: count from activeSession logs this week
  return volumes;
}

