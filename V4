      </div>
    </div>`;

  // Convert to base64
  const base64 = await new Promise((res,rej)=>{
    const reader = new FileReader();
    reader.onload = ()=> res(reader.result.split(',')[1]);
    reader.onerror = rej;
    reader.readAsDataURL(file);
  });

  // Create object URL for preview
  const previewURL = URL.createObjectURL(file);

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:400,
        messages:[{
          role:'user',
          content:[
            {
              type:'image',
              source:{type:'base64', media_type:file.type||'image/jpeg', data:base64}
            },
            {
              type:'text',
              text:`Du bist ein Ernährungsexperte. Analysiere dieses Essen-Foto und schätze die Nährstoffe.
Antworte NUR mit gültigem JSON (kein Markdown, keine Erklärung):
{"name":"Mahlzeit-Name auf Deutsch","kcal":350,"protein":30,"carbs":35,"fat":8,"confidence":"hoch|mittel|niedrig","note":"kurze Erklärung"}`
            }
          ]
        }]
      })
    });

    const data = await response.json();
    const text = data.content?.[0]?.text || '';

    let result;
    try {
      // Strip any markdown fences
      const clean = text.replace(/```json?/g,'').replace(/```/g,'').trim();
      result = JSON.parse(clean);
    } catch {
      result = { name:'Erkannte Mahlzeit', kcal:400, protein:25, carbs:40, fat:12, confidence:'mittel', note:'Schätzung basierend auf sichtbaren Lebensmitteln.' };
