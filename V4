function updateStreak(){
  const today=new Date().toISOString().split('T')[0];
  if(lastActive===today) return;
  const yest=new Date();yest.setDate(yest.getDate()-1);
  const y=yest.toISOString().split('T')[0];
  streak=lastActive===y?streak+1:1;
  lastActive=today;weekDone[today]=true;
  DB.set('streak',streak);DB.set('lastAct',lastActive);DB.set('wkDone',weekDone);
  if(streak>=3) unlockAch('ach-streak3',75);
  if(streak>=7){unlockAch('ach-streak7',100);addPoints(100,'7-Tage Streak!');}
}

function refreshGame(){
  document.getElementById('streak-display').textContent=streak;
