// ── RECOVERY SCORE ────────────────────────────────────
function renderRecoveryScore() {
  const recentFat = fatLog.slice(-3);
  const avgFat = recentFat.length ? recentFat.reduce((a,b)=>a+b,0)/recentFat.length : 3;
  // Score: 100 = perfect, based on fatigue (inverted), streak consistency, days since last workout
  const fatScore = Math.max(0, 100 - (avgFat-1)*20);
  const streakBonus = Math.min(20, streak * 3);
  const score = Math.min(100, Math.round(fatScore * 0.7 + streakBonus + 10));

  const el = document.getElementById('recovery-score-val');
  const ring = document.getElementById('recovery-ring-fg');
  const label = document.getElementById('recovery-label');
  const detail = document.getElementById('recovery-detail');
  if(!el) return;

  el.textContent = score;
  const offset = 164 - (score/100)*164;
  if(ring) ring.style.strokeDashoffset = offset;

  let color, labelText, detailText;
  if(score >= 80) {
    color='var(--green)'; labelText='Sehr gut erholt'; detailText='Volle Intensität empfohlen. Dein Körper ist bereit.';
  } else if(score >= 60) {
    color='var(--orange)'; labelText='Gut erholt'; detailText='Normales Training. Aufwärmen nicht überspringen.';
  } else if(score >= 40) {
    color='var(--accent)'; labelText='Mäßige Erholung'; detailText='Volumen leicht reduzieren. Auf Körpersignale achten.';
  } else {
    color='var(--violet)'; labelText='Erschöpft – Deload!'; detailText='Volumen –50%, Intensität –15%. Schlaf & Protein priorisieren.';
  }
  if(ring) ring.style.stroke = color;
  if(label){ label.textContent=labelText; label.style.color=color; }
  if(detail) detail.textContent=detailText;
}

