function checkMissedSessions() {
  const container = document.getElementById('missed-session-section');
  if(!container) return;
  if(!lastActive) { container.style.display='none'; return; }

  const daysSince = Math.floor((Date.now()-new Date(lastActive).getTime()) / 86400000);
  if(daysSince < 2) { container.style.display='none'; return; }

  let advice='';
  if(daysSince <= 3) {
    advice='Kein Problem – deine Gewichte bleiben gleich. Einfach weitermachen wo du aufgehört hast.';
  } else if(daysSince <= 7) {
    advice='Leichte Deload-Woche empfohlen: Gewichte –10%, Volumen normal. Danach normale Progression.';
  } else {
    advice='Längere Pause erkannt. Starte mit ~80% deiner letzten Gewichte. Der Algorithmus kalibriert sich nach 2 Sessions neu.';
  }

  container.style.display='block';
  container.innerHTML=`
    <div class="missed-banner">
      <div style="font-size:22px">📅</div>
      <div>
        <strong style="color:var(--orange)">Letztes Training: vor ${daysSince} Tagen</strong><br>
        ${advice}
        ${daysSince>7?'<br><br><button onclick="applyMissedSessionReset()" style="margin-top:6px;background:var(--orange);color:#000;border:none;border-radius:8px;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--f)">Gewichte automatisch anpassen</button>':''}
      </div>
    </div>`;
}

function applyMissedSessionReset() {
  // Reduce all recent weights by 15% after long break
  Object.keys(exHist).forEach(ex => {
    if(exHist[ex].length > 0) {
      const last = exHist[ex][exHist[ex].length-1];
      exHist[ex].push({
        ...last,
        weight: Math.round(last.weight * 0.85 * 4)/4,
        rpe: 7,
        date: new Date().toISOString(),
        note: 'Auto-Reset nach langer Pause'
      });
    }
  });
  DB.set('exH', exHist);
  showToast('✅ Gewichte um 15% reduziert. Kalibrierung startet.');
  checkMissedSessions();
}

// ── RIR-AWARE PROGRESSION ─────────────────────────────
// Enhanced calcNext to also accept RIR (Reps in Reserve)
// RIR 0 = failure, RIR 4+ = too easy
function calcNextWithRIR(hist, tMin, tMax, rpe, rir) {
  // Convert RIR to RPE equivalent if RIR provided
  let effectiveRPE = rpe;
  if(rir !== undefined && rir !== null) {
    effectiveRPE = 10 - rir; // RIR 0 = RPE 10, RIR 2 = RPE 8
  }
  // Bigger jump if RIR >= 4 (too easy)
  const result = calcNext(hist, tMin, tMax, effectiveRPE);
  if(rir >= 4 && result.nextWeight) {
    const bigJump = result.nextWeight + (hist[hist.length-1]?.weight >= 80 ? 2.5 : 1.25);
    result.nextWeight = bigJump;
    result.note = '🚀 RIR ' + rir + ' – Gewicht war zu leicht! Aggressivere Steigerung: +' + (bigJump - hist[hist.length-1]?.weight).toFixed(1) + 'kg.';
  }
  return result;
}

