}

function discardWorkout() {
  if(!confirm('Training wirklich verwerfen? Alle Eingaben gehen verloren.')) return;
  document.getElementById('ws-summary-modal').style.display = 'none';
  DB.set('activeWS', null);
  activeSession = null;
  sp('dash');
}

function confirmDiscardWorkout() {
  if(!activeSession) { sp('plan'); return; }
  if(confirm('Training abbrechen? Fortschritt geht verloren.')) {
    clearInterval(wsElapsedTimer); stopRestTimer();
    DB.set('activeWS', null); activeSession = null;
    sp('plan');
  }
}

// ── REST TIMER ────────────────────────────────────────
function startRestTimer(secs) {
  stopRestTimer();
  wsRestRemaining = secs;
  updateRestDisplay();
  wsRestTimer = setInterval(() => {
    wsRestRemaining--;
    updateRestDisplay();
    if(wsRestRemaining <= 0) {
      stopRestTimer();
      showToast('⏰ Pause vorbei – nächster Satz!');
    }
  }, 1000);
}
function stopRestTimer() {
  clearInterval(wsRestTimer); wsRestTimer = null;
  wsRestRemaining = 0;
  const el = document.getElementById('ws-rest-display');
  if(el) el.textContent = '—';
}
function updateRestDisplay() {
  const el = document.getElementById('ws-rest-display');
  if(!el) return;
  const m = Math.floor(wsRestRemaining/60).toString().padStart(2,'0');
  const s = (wsRestRemaining%60).toString().padStart(2,'0');
  el.textContent = m+':'+s;
  el.style.color = wsRestRemaining <= 10 ? 'var(--accent)' : 'var(--t1)';
}

