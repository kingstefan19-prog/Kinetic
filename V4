let activeSession = null; // restored below after DB is ready
let wsElapsedSecs = 0;
let wsElapsedTimer = null;
let wsRestTimer = null;
let wsRestRemaining = 0;
let wsSuggestionData = null;

// ── START WORKOUT ──────────────────────────────────────
function openLog(dayKey, firstEx, sets, reps) {
  // Use planState override if present, otherwise DEFAULT_PLAN
  const exList = (planState?.[dayKey] || DEFAULT_PLAN[dayKey] || []).map(ex => ({
    ...ex,
    reps: ex.sets.split('×')[1] || '6–8'
  }));

  // Fallback: single exercise if dayKey not found
  if(!exList.length) exList.push({name:firstEx, note:'', sets:sets+'×'+reps, group:'', muscle:'', reps});

  const sessionNames = {mo:'Montag · Push', mi:'Mittwoch · Pull', do:'Donnerstag · Legs'};

  activeSession = {
    dayKey,
    sessionName: sessionNames[dayKey] || 'Workout',
    startTime: Date.now(),
    exercises: exList,
    currentExIdx: 0,
    logs: {},
    savedToHistory: false
  };
  DB.set('activeWS', activeSession);

  wsElapsedSecs = 0;
  clearInterval(wsElapsedTimer);
  wsElapsedTimer = setInterval(() => {
    wsElapsedSecs++;
    const m = Math.floor(wsElapsedSecs/60).toString().padStart(2,'0');
    const s = (wsElapsedSecs%60).toString().padStart(2,'0');
    const el = document.getElementById('ws-elapsed');
    if(el) el.textContent = m+':'+s;
  }, 1000);

  sp('log');
  renderWSExercise();
}

// ── RENDER CURRENT EXERCISE ────────────────────────────
function renderWSExercise() {
  if(!activeSession) return;
  const {exercises, currentExIdx, logs, sessionName} = activeSession;
  const ex = exercises[currentExIdx];
  const total = exercises.length;
  const isLast = currentExIdx === total - 1;

  // Top bar
  document.getElementById('ws-session-label').textContent = sessionName.toUpperCase();
  document.getElementById('ws-ex-counter').textContent = (currentExIdx+1) + ' / ' + total;
  document.getElementById('ws-progress-bar').style.width = ((currentExIdx/total)*100) + '%';

  // Exercise info
  document.getElementById('ws-ex-name').textContent = ex.name;
  document.getElementById('ws-ex-group').textContent = ex.note || ex.group || '';
  const repRange = ex.sets.split('×')[1] || ex.reps || '6–8';
  const numSets  = parseInt(ex.sets.split('×')[0]) || 4;
  document.getElementById('ws-ex-target').textContent = numSets + ' Sätze · ' + repRange + ' Wdh';

  // Pill navigation
  const pillRow = document.getElementById('ws-pill-row');
  pillRow.innerHTML = exercises.map((e,i) => {
    const done = logs[e.name]?.some(s=>s.done);
    const isActive = i === currentExIdx;
    return `<button onclick="wsJumpTo(${i})" style="
      flex-shrink:0;padding:5px 10px;border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;
      font-family:var(--f);white-space:nowrap;border:1.5px solid ${isActive?'var(--accent)':done?'var(--green)':'var(--border2)'};
      background:${isActive?'var(--accent)':done?'rgba(52,199,89,.12)':'var(--card2)'};
      color:${isActive?'#000':done?'var(--green)':'var(--t3)'}">
      ${done?'✓ ':''} ${e.name.split(' ')[0]}
    </button>`;
  }).join('');

  // Weight suggestion
  const hist = exHist[ex.name] || [];
  const parts = repRange.split('–');
  const tMin = parseInt(parts[0])||6, tMax = parseInt(parts[1])||(parseInt(parts[0])||6)+2;
  const chip = document.getElementById('ws-suggestion-chip');
  if(chip) {
    if(hist.length > 0) {
      const next = calcNext(hist, tMin, tMax, hist[hist.length-1].rpe||8);
      if(next.nextWeight) {
        wsSuggestionData = next;
        const suggText = document.getElementById('ws-suggestion-text');
        if(suggText) suggText.textContent =
          `Vorgeschlagen (${hist.length} Session${hist.length>1?'s':''}): ${next.nextWeight} kg × ${next.nextReps} Wdh`;
        chip.style.display = 'flex';
      } else { chip.style.display = 'none'; wsSuggestionData = null; }
    } else { chip.style.display = 'none'; wsSuggestionData = null; }
  }

  // Render sets (restore saved or default 4 rows)
  renderWSSets(ex.name, numSets);

  // Prev/Next buttons
  document.getElementById('ws-prev-btn').style.opacity = currentExIdx === 0 ? '0.3' : '1';
  document.getElementById('ws-prev-btn').disabled = currentExIdx === 0;
  document.getElementById('ws-next-btn').textContent = isLast
    ? '✅ Training abschließen'
    : 'Nächste Übung →';
  document.getElementById('ws-next-btn').style.background = isLast ? 'var(--green)' : 'var(--accent)';

  // Fatigue only on last exercise
  document.getElementById('ws-fatigue-section').style.display = isLast ? 'block' : 'none';

  window.scrollTo({top:0, behavior:'smooth'});
}

// ── RENDER SETS FOR CURRENT EXERCISE ──────────────────
function renderWSSets(exName, defaultCount) {
  const container = document.getElementById('ws-sets-container');
  const saved = activeSession.logs[exName] || [];
  // Ensure at least defaultCount rows
  while(saved.length < defaultCount) saved.push({kg:'',reps:'',rpe:8,done:false});
  activeSession.logs[exName] = saved;
  DB.set('activeWS', activeSession);

  container.innerHTML = saved.map((s,i) => `
    <div style="display:grid;grid-template-columns:24px 1fr 1fr 52px 28px;gap:6px;margin-bottom:6px;align-items:center" id="ws-set-row-${i}">
      <div style="font-size:12px;font-weight:600;color:var(--t3);text-align:center">${i+1}</div>
      <input class="li" type="number" placeholder="kg" value="${s.kg||''}"
        oninput="wsUpdateSet('${exName}',${i},'kg',this.value)"
        style="padding:9px;font-size:15px;${s.done?'opacity:.6':''}"
        ${s.done?'disabled':''}>
      <input class="li" type="number" placeholder="Wdh" value="${s.reps||''}"
        oninput="wsUpdateSet('${exName}',${i},'reps',this.value)"
        style="padding:9px;font-size:15px;${s.done?'opacity:.6':''}"
        ${s.done?'disabled':''}>
      <select oninput="wsUpdateSet('${exName}',${i},'rpe',this.value)"
        style="background:var(--card2);border:1.5px solid var(--border2);border-radius:8px;color:${s.done?'var(--t3)':'var(--t1)'};font-family:var(--f);font-size:12px;padding:8px 4px;outline:none;width:100%;${s.done?'opacity:.6':''}"
        ${s.done?'disabled':''}>
        ${[6,7,8,9,10].map(v=>`<option value="${v}" ${s.rpe==v?'selected':''}>${v}</option>`).join('')}
      </select>
      <div onclick="wsToggleDone('${exName}',${i})"
        style="width:28px;height:28px;border-radius:7px;border:1.5px solid ${s.done?'var(--green)':'var(--border2)'};
        background:${s.done?'var(--green)':'transparent'};cursor:pointer;display:flex;align-items:center;
        justify-content:center;font-size:14px;color:${s.done?'#000':'transparent'};transition:all .15s">✓</div>
    </div>`).join('');
}

function wsUpdateSet(exName, idx, field, value) {
  if(!activeSession.logs[exName]) activeSession.logs[exName] = [];
  activeSession.logs[exName][idx][field] = field==='rpe'?parseInt(value):parseFloat(value)||value;
  DB.set('activeWS', activeSession);
}

function wsToggleDone(exName, idx) {
  if(!activeSession.logs[exName]) return;
  const set = activeSession.logs[exName][idx];
  if(!set.kg || !set.reps) { showToast('Gewicht & Wdh zuerst eintragen'); return; }
  set.done = !set.done;
  DB.set('activeWS', activeSession);
  renderWSSets(exName, activeSession.logs[exName].length);
}

function wsAddSet() {
  const ex = activeSession.exercises[activeSession.currentExIdx];
  if(!activeSession.logs[ex.name]) activeSession.logs[ex.name] = [];
  activeSession.logs[ex.name].push({kg:'',reps:'',rpe:8,done:false});
  DB.set('activeWS', activeSession);
  renderWSSets(ex.name, activeSession.logs[ex.name].length);
}

function applyWSSuggestion() {
  if(!wsSuggestionData) return;
  const ex = activeSession.exercises[activeSession.currentExIdx];
  const logs = activeSession.logs[ex.name] || [];
  // Fill first empty set
  const firstEmpty = logs.findIndex(s => !s.kg);
  const targetIdx = firstEmpty >= 0 ? firstEmpty : 0;
  if(!logs[targetIdx]) logs[targetIdx] = {kg:'',reps:'',rpe:8,done:false};
  logs[targetIdx].kg   = wsSuggestionData.nextWeight;
  logs[targetIdx].reps = wsSuggestionData.nextReps;
  activeSession.logs[ex.name] = logs;
  DB.set('activeWS', activeSession);
  renderWSSets(ex.name, logs.length);
  showToast(`💡 ${wsSuggestionData.nextWeight}kg × ${wsSuggestionData.nextReps} Wdh eingetragen`);
}

// ── NAVIGATION ────────────────────────────────────────
function wsJumpTo(idx) {
  activeSession.currentExIdx = idx;
  DB.set('activeWS', activeSession);
  renderWSExercise();
}

function wsPrevEx() {
  if(activeSession.currentExIdx <= 0) return;
  activeSession.currentExIdx--;
  DB.set('activeWS', activeSession);
  renderWSExercise();
}

function wsNextOrFinish() {
  const {exercises, currentExIdx} = activeSession;
  if(currentExIdx < exercises.length - 1) {
    activeSession.currentExIdx++;
    DB.set('activeWS', activeSession);
    renderWSExercise();
  } else {
    finishWorkout();
  }
}

// ── FINISH WORKOUT & RUN ALGO ─────────────────────────
function finishWorkout() {
  clearInterval(wsElapsedTimer);
  stopRestTimer();

  const {exercises, logs} = activeSession;
  let totalSets = 0, totalVolume = 0;
  const algoResults = [];
  let totalXP = 0;

  // Run algo for every logged exercise
  exercises.forEach(ex => {
    const sets = (logs[ex.name] || []).filter(s => s.done && s.kg && s.reps);
    if(!sets.length) return;
    totalSets += sets.length;
    sets.forEach(s => { totalVolume += (parseFloat(s.kg)||0) * (parseInt(s.reps)||0); });

    // Save to exercise history
    const best = sets.reduce((a,b) => (parseFloat(a.kg)||0) >= (parseFloat(b.kg)||0) ? a : b, sets[0]);
    const avgRPE = Math.round(sets.reduce((a,s)=>a+(s.rpe||8),0)/sets.length);
    if(!exHist[ex.name]) exHist[ex.name] = [];
    const entry = {
      weight: parseFloat(best.kg),
      reps:   parseInt(best.reps),
      rpe:    avgRPE,
      e1rm:   e1rm(parseFloat(best.kg), parseInt(best.reps)),
      date:   new Date().toISOString()
    };
    exHist[ex.name].push(entry);

    // Calculate next weights
    const parts = (ex.sets.split('×')[1]||'6–8').split('–');
    const tMin=parseInt(parts[0])||6, tMax=parseInt(parts[1])||8;
    const next = calcNext(exHist[ex.name], tMin, tMax, avgRPE);
    const dl   = checkDeload(exHist[ex.name]);

    algoResults.push({ ex:ex.name, sets, best, entry, next, deload:dl });
  });

  DB.set('exH', exHist);

  // Gamification
  updateStreak();
  const xpBase = 50 + (exercises.length * 10);
  addPoints(xpBase, 'Workout abgeschlossen');
  totalXP = xpBase;
  unlockAch('ach-first', 50);
  const totalWorkouts = Object.values(exHist).flat().length;
  if(totalWorkouts >= 5) unlockAch('ach-5workouts', 150);

  // Render summary modal
  const durationMins = Math.round(wsElapsedSecs / 60);
  document.getElementById('sum-duration').textContent = `Dauer: ${durationMins} Minuten`;
  document.getElementById('sum-exercises').textContent = Object.keys(logs).filter(k=>logs[k].some(s=>s.done)).length;
  document.getElementById('sum-sets').textContent = totalSets;
  document.getElementById('sum-volume').textContent = Math.round(totalVolume/1000*10)/10 + 't';
  document.getElementById('sum-xp').textContent = `+${totalXP} XP`;

  // Per-exercise breakdown
  document.getElementById('sum-ex-list').innerHTML = algoResults.map(r => {
    const setsStr = r.sets.map(s=>`${s.kg}kg×${s.reps}`).join(', ');
    return `<div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:12px;margin-bottom:8px">
      <div style="font-size:14px;font-weight:600;margin-bottom:6px">${r.ex}</div>
      <div style="font-size:12px;color:var(--t2);margin-bottom:4px">Sätze: ${setsStr}</div>
      <div style="display:flex;justify-content:space-between;font-size:12px">
        <span style="color:var(--t3)">E1RM: <strong style="color:var(--t1)">${Math.round(r.entry.e1rm)} kg</strong></span>
        <span style="color:var(--green)">Nächste: ${r.next.nextWeight||'~'} kg × ${r.next.nextReps}</span>
      </div>
      ${r.deload.deload?`<div style="margin-top:6px;font-size:11px;color:var(--violet)">🟣 Deload: ${r.deload.reason}</div>`:''}
    </div>`;
  }).join('') || '<div style="font-size:13px;color:var(--t3);text-align:center;padding:16px">Keine Sätze geloggt.</div>';

  document.getElementById('sum-algo-results').innerHTML = '';
  document.getElementById('ws-summary-modal').style.display = 'block';
  activeSession.savedToHistory = true;
  DB.set('activeWS', null);
  activeSession = null;
}

function closeSummary() {
  document.getElementById('ws-summary-modal').style.display = 'none';
