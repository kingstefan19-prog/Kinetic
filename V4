// FEATURE 4: Nutrition → Algo impact
function computeNutritionImpact(){
  if(nutrHistory.length < 2) return null;
  const recent = nutrHistory.slice(-3);
  const target = TARGETS.normal;
  const avgKcal = recent.reduce((a,b)=>a+b.kcal,0)/recent.length;
  const avgP    = recent.reduce((a,b)=>a+b.p,0)  /recent.length;
  const deficit = target.kcal - avgKcal;
  const pctDef  = deficit / target.kcal;

  if(pctDef > 0.2) return {
    type:'deficit',
    msg:`Ø ${Math.round(avgKcal)} kcal über ${recent.length} Tage – ${Math.round(deficit)} kcal unter Ziel.`,
    action:'Volumen heute –20%. Deload ggf. früher. Protein prioritisieren.',
    volumeMod: -0.2
  };
  if(pctDef < -0.1 && avgP >= target.p * 0.9) return {
    type:'surplus',
    msg:`Ø ${Math.round(avgKcal)} kcal über ${recent.length} Tage – Surplus von ~${Math.round(-deficit)} kcal.`,
    action:'Progression kann etwas aggressiver sein (+1 Rep extra möglich).',
    volumeMod: 0.1
  };
  return {type:'ok', msg:'Kalorien & Makros im Zielbereich.', action:'Normale Progression.', volumeMod:0};
}

function renderNutritionImpact(){
  const impact = computeNutritionImpact();
  const panel = document.getElementById('nutr-algo-panel');
  if(!panel||!impact) return;
  const cls = {deficit:'na-deficit', surplus:'na-surplus', ok:'na-ok'};
  const icons = {deficit:'📉', surplus:'📈', ok:'✅'};
  panel.innerHTML = `
    <div class="nutr-algo-card ${cls[impact.type]}">
      <div class="na-icon">${icons[impact.type]}</div>
      <div class="na-text">
        <strong>Ernährung → Trainingsplan Feedback</strong>
        ${impact.msg}<br><em style="color:var(--t1)">${impact.action}</em>
      </div>
    </div>`;
}

