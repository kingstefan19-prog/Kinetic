function logWeight(){
  const val=parseFloat(document.getElementById('new-weight').value);
  if(!val||val<40||val>300){alert('Gültiges Gewicht eingeben (40–300 kg)');return}
  weightLog.push({w:val,d:new Date().toISOString().split('T')[0]});
  DB.set('wLog',weightLog);
  document.getElementById('new-weight').value='';
  refreshDash();
  if((108-val)>=1) unlockAch('ach-weight1',200);
