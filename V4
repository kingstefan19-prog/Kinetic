function openReplaceModal(day, exIdx, oldName){
  replaceTarget = {day, exIdx, oldName};
  const alts = ALTERNATIVES[oldName] || ALTERNATIVES['default'];
  const filtered = alts.filter(a => !bannedEx.includes(a.name));

  document.getElementById('modal-title').textContent = oldName + ' ersetzen';
  document.getElementById('modal-sub').textContent = 'Wähle eine Alternative für ' + (replaceTarget.day==='mo'?'Montag Push':replaceTarget.day==='mi'?'Mittwoch Pull':'Donnerstag Legs');

  const diffLabel = {same:'Gleich', easier:'Leichter', harder:'Schwerer'};
  const diffClass = {same:'d-same', easier:'d-easy', harder:'d-hard'};

  document.getElementById('modal-alts').innerHTML = filtered.map(alt=>`
    <div class="alt-item" onclick="confirmReplace('${alt.name}')">
      <div class="alt-icon">${alt.icon}</div>
      <div class="alt-info">
        <div class="alt-name">${alt.name}</div>
        <div class="alt-detail">${alt.detail}</div>
      </div>
      <span class="alt-diff ${diffClass[alt.diff]}">${diffLabel[alt.diff]}</span>
    </div>`).join('');

  document.getElementById('replace-modal').classList.add('open');
}

function confirmReplace(newName){
  if(!replaceTarget) return;
  const {day, exIdx, oldName} = replaceTarget;

  // handleManualExerciseChange: archive old, reset new
  if(exHist[oldName]?.length){
    exHist['_arch_'+oldName] = exHist[oldName];
    delete exHist[oldName];
  }
  exHist[newName] = exHist[newName] || [];
  DB.set('exH', exHist);

  // Update plan state
  if(!planState) planState = JSON.parse(JSON.stringify(DEFAULT_PLAN));
  planState[day][exIdx] = {
    ...planState[day][exIdx],
    name: newName,
    note: `Ersetzt von: ${oldName} · Neu kalibriert`
  };
  DB.set('plan', planState);

  closeReplaceModal();
  renderPlan();
  unlockAch('ach-replaced', 25);
  showToast(`✅ ${oldName} → ${newName}. Progression wird neu kalibriert.`);
}

function banCurrentExercise(){
  if(!replaceTarget) return;
  const name = replaceTarget.oldName;
  if(!bannedEx.includes(name)) bannedEx.push(name);
  DB.set('banned', bannedEx);
  closeReplaceModal();
  renderPlan();
  showToast(`🚫 ${name} dauerhaft gesperrt.`);
}

function unbanEx(name){
  bannedEx = bannedEx.filter(b=>b!==name);
  DB.set('banned', bannedEx);
  renderPlan();
}

function renderBanned(){
  const list = document.getElementById('banned-list');
  if(!list) return;
  if(!bannedEx.length){list.innerHTML='<span style="font-size:12px;color:var(--t3)">Noch keine gesperrten Übungen.</span>';return;}
  list.innerHTML = bannedEx.map(b=>`
    <div class="banned-chip">${b}<button onclick="unbanEx('${b}')">✕</button></div>`).join('');
}

function closeReplaceModal(){
  document.getElementById('replace-modal').classList.remove('open');
  replaceTarget=null;
}
function closeModal(e){if(e.target.id==='replace-modal') closeReplaceModal();}

