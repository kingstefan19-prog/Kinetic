function drawWeightChart(){
  const svg=document.getElementById('weight-chart');
  if(!weightLog.length){return}
  const W=320,H=110,PAD=18;
  const vals=weightLog.map(e=>e.w);
  const min=Math.min(...vals)-1,max=Math.max(...vals)+1;
  const xStep=(W-PAD*2)/Math.max(vals.length-1,1);
  const yScale=v=>H-PAD-((v-min)/(max-min))*(H-PAD*2);
  const pts=vals.map((v,i)=>`${PAD+i*xStep},${yScale(v)}`).join(' ');
  const area=`M${PAD},${H-PAD} `+vals.map((v,i)=>`L${PAD+i*xStep},${yScale(v)}`).join(' ')+` L${PAD+(vals.length-1)*xStep},${H-PAD} Z`;
  svg.innerHTML=`
    <defs><linearGradient id="wg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#E63939" stop-opacity=".3"/><stop offset="100%" stop-color="#E63939" stop-opacity="0"/></linearGradient></defs>
    <path d="${area}" fill="url(#wg)"/>
    <polyline points="${pts}" fill="none" stroke="#E63939" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    ${vals.map((v,i)=>`<circle cx="${PAD+i*xStep}" cy="${yScale(v)}" r="${i===vals.length-1?5:3}" fill="#E63939" ${i===vals.length-1?'stroke="#121212" stroke-width="2"':''}/>`).join('')}
    ${vals.length<=8?vals.map((v,i)=>`<text x="${PAD+i*xStep}" y="${yScale(v)-8}" text-anchor="middle" font-size="10" fill="#AAAAAA" font-family="Inter">${v}</text>`).join(''):''}
    <text x="${PAD}" y="${H-2}" font-size="9" fill="#666" font-family="Inter">Start</text>
    <text x="${PAD+(vals.length-1)*xStep}" y="${H-2}" text-anchor="end" font-size="9" fill="#666" font-family="Inter">Heute</text>`;
}

function loadFoto(slot,input){
  const file=input.files[0];if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    fotos[slot]=e.target.result;DB.set('fotos',fotos);
    showFotoImg(slot,e.target.result);
    document.getElementById('foto-date-'+slot).textContent=(slot===1?'Vorher':'Nachher')+' · '+new Date().toLocaleDateString('de');
  };
  reader.readAsDataURL(file);
}
function showFotoImg(slot,data){
  const img=document.getElementById('foto-img-'+slot);
  if(!img) return;
  img.src=data;img.style.display='block';
  const sl=img.closest('.foto-slot');
  if(sl){sl.querySelector('.foto-slot-icon').style.display='none';sl.querySelector('.foto-slot-lbl').style.display='none';}
}

