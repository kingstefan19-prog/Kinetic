// ── 4. VOICE COACH ────────────────────────────────────
let voiceRecognition = null;
let isListening = false;

function toggleVoiceCoach() {
  if(!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
    showToast('🎙️ Spracherkennung nicht verfügbar. Verwende Chrome/Safari.');
    return;
  }
  if(isListening) {
    stopVoiceCoach();
  } else {
    startVoiceCoach();
  }
}

function startVoiceCoach() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  voiceRecognition = new SpeechRecognition();
  voiceRecognition.lang = 'de-DE';
  voiceRecognition.continuous = false;
  voiceRecognition.interimResults = false;

  voiceRecognition.onstart = () => {
    isListening = true;
    const btn = document.getElementById('voice-btn');
    if(btn) { btn.classList.add('listening'); btn.querySelector('.vb-sub').textContent = 'Höre zu… Sprich deine Frage'; }
    showToast('🎙️ Jetzt sprechen…');
  };

  voiceRecognition.onresult = async (e) => {
    const question = e.results[0][0].transcript;
    stopVoiceCoach();
    showToast('💭 Verarbeite: "' + question + '"');
    // Set the question in the text area too
    const ta = document.getElementById('user-q');
    if(ta) ta.value = question;
    // Call Claude and speak the answer
    const res = document.getElementById('q-resp');
    if(res) { res.style.display = 'block'; res.innerHTML = '<span style="color:var(--t3)">⏳ Analysiere…</span>'; }
    const answer = await callClaude(`Elite-Athletik-Coach. Kurze präzise Antwort auf Deutsch, max 3 Sätze, klar und direkt (wird vorgelesen).\nProfil:\n${PROFILE}\nFrage: ${question}`);
    if(res) res.innerHTML = answer;
    // Text-to-speech
    speakText(answer.replace(/<[^>]*>/g, ''));
  };

  voiceRecognition.onerror = () => { stopVoiceCoach(); showToast('Sprache nicht erkannt. Nochmal versuchen.'); };
  voiceRecognition.onend = () => stopVoiceCoach();
  voiceRecognition.start();
}

function stopVoiceCoach() {
  isListening = false;
  if(voiceRecognition) { try{ voiceRecognition.stop(); } catch(e){} }
  const btn = document.getElementById('voice-btn');
  if(btn) { btn.classList.remove('listening'); btn.querySelector('.vb-sub').textContent = 'Stell eine Frage per Sprache – Coach antwortet laut'; }
}

function speakText(text) {
  if(!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const utt = new SpeechSynthesisUtterance(text);
  utt.lang = 'de-DE';
  utt.rate = 0.95;
  utt.pitch = 1;
  // Pick a German voice if available
  const voices = window.speechSynthesis.getVoices();
  const deVoice = voices.find(v => v.lang.startsWith('de'));
  if(deVoice) utt.voice = deVoice;
  window.speechSynthesis.speak(utt);
}

// ── 5. SMART AI NOTIFICATIONS ─────────────────────────
function renderSmartNotifications() {
  const container = document.getElementById('smart-notifications');
  if(!container) return;

  const notifications = [];
  const today = new Date().toISOString().split('T')[0];
  const sleep = getLastSleepHours();
  const daysSince = lastActive ? Math.floor((Date.now()-new Date(lastActive).getTime())/86400000) : 99;

  // PR detection
  Object.keys(exHist).forEach(ex => {
    const hist = exHist[ex];
    if(hist.length >= 2) {
      const last = hist[hist.length-1];
      const prev = hist[hist.length-2];
      if(last.e1rm > prev.e1rm * 1.03) {
        notifications.push({
          type: 'pr', icon: '🏆',
          title: 'Neuer Persönlicher Rekord!',
          body: `${ex}: E1RM von ${Math.round(prev.e1rm)} → ${Math.round(last.e1rm)} kg (+${Math.round(last.e1rm-prev.e1rm)} kg)`
        });
      }
    }
  });

  // Sleep warning
  if(sleep <= 5) {
    notifications.push({
      type: 'sleep', icon: '😴',
      title: 'Wenig Schlaf erkannt',
      body: `Nur ${sleep}h Schlaf → Progression heute verlangsamt. Mehr Pausen einplanen.`
    });
  }

  // Missed session
  if(daysSince >= 3 && daysSince < 20) {
    notifications.push({
      type: 'warn', icon: '📅',
      title: `Letztes Training: vor ${daysSince} Tagen`,
      body: daysSince <= 5 ? 'Gewichte bleiben gleich. Einfach weitermachen.' : 'Starte mit ~85% der letzten Gewichte. Algorithmus kalibriert neu.'
    });
  }

  // Deload suggestion
  const recentFatigue = fatLog.slice(-3);
  if(recentFatigue.length >= 3 && recentFatigue.reduce((a,b)=>a+b,0)/3 >= 4) {
    notifications.push({
      type: 'warn', icon: '🟣',
      title: 'Deload empfohlen',
      body: 'Hohe Fatigue der letzten Tage → Volumen –50%, Intensität –15% diese Woche.'
    });
  }

  if(!notifications.length) { container.innerHTML = ''; return; }

  const colorMap = { pr:'sb-pr', sleep:'sb-sleep', warn:'sb-warn' };
  container.innerHTML = notifications.slice(0,2).map(n => `
    <div class="smart-banner ${colorMap[n.type]||'sb-warn'}">
      <div class="sb-icon">${n.icon}</div>
      <div class="sb-body"><strong>${n.title}</strong>${n.body}</div>
    </div>`).join('');
}

// ── 6. STRENGTH BENCHMARKS ────────────────────────────
// Standards for 108kg bodyweight (intermediate/advanced/elite ratio)
const BENCH_STANDARDS = {
  'Bankdrücken (LH)':         {inter:100, adv:130, elite:160},
  'Kniebeuge (LH)':           {inter:120, adv:160, elite:200},
  'Rumänisches Kreuzheben':   {inter:110, adv:150, elite:190},
  'LH-Rudern':                {inter:90,  adv:120, elite:150},
  'Schulterdrücken':          {inter:65,  adv:90,  elite:115},
  'Latzug zur Brust':         {inter:85,  adv:110, elite:140},
};

function renderStrengthBenchmarks() {
  const container = document.getElementById('bench-list');
  if(!container) return;

  const rows = Object.entries(BENCH_STANDARDS).map(([ex, std]) => {
    const hist = exHist[ex];
    const e1rmVal = hist?.length ? Math.round(hist[hist.length-1].e1rm) : null;

    let cls = 'bench-avg-cls', label = 'Noch nicht geloggt', pct = '';
    if(e1rmVal) {
      if(e1rmVal >= std.elite)       { cls = 'bench-elite'; label = '🏆 Elite'; }
      else if(e1rmVal >= std.adv)    { cls = 'bench-good';  label = '⭐ Fortgeschritten'; }
      else                           { cls = 'bench-avg-cls'; label = '📈 Aufbau'; }
      pct = `E1RM: ${e1rmVal} kg`;
    }

    return `<div class="bench-row">
      <div class="bench-ex">${ex}</div>
      <div style="text-align:right">
        <div style="font-size:12px;color:var(--t2)">${pct}</div>
        <span class="bench-pct ${cls}">${label}</span>
      </div>
    </div>`;
  }).join('');

  container.innerHTML = rows + `
    <div style="margin-top:10px;font-size:11px;color:var(--t3);line-height:1.5">
      Standards für 108 kg Körpergewicht. Mehr Sessions loggen = präzisere Werte.
    </div>`;
}

