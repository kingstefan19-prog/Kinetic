function importData(input) {
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if(!data.version) throw new Error('Ungültiges Format');
      // Restore all data
      if(data.exHist)      { exHist=data.exHist;           DB.set('exH',exHist); }
      if(data.fatLog)      { fatLog=data.fatLog;            DB.set('fatL',fatLog); }
      if(data.weightLog)   { weightLog=data.weightLog;      DB.set('wLog',weightLog); }
      if(data.meals)       { meals=data.meals;              DB.set('meals',meals); }
      if(data.nutrHistory) { nutrHistory=data.nutrHistory;  DB.set('nutrH',nutrHistory); }
      if(data.streak!=null){ streak=data.streak;            DB.set('streak',streak); }
      if(data.lastActive)  { lastActive=data.lastActive;    DB.set('lastAct',lastActive); }
      if(data.points!=null){ points=data.points;            DB.set('pts',points); }
      if(data.achs)        { achs=data.achs;                DB.set('achs',achs); }
      if(data.weekDone)    { weekDone=data.weekDone;        DB.set('wkDone',weekDone); }
      if(data.planState)   { planState=data.planState;      DB.set('plan',planState); }
      if(data.bannedEx)    { bannedEx=data.bannedEx;        DB.set('banned',bannedEx); }
      showToast('✅ Import erfolgreich! Daten wiederhergestellt.');
      refreshDash(); renderPlan(); refreshDataPage();
    } catch(err) {
      alert('Import fehlgeschlagen: ' + err.message);
    }
  };
  reader.readAsText(file);
  input.value='';
}

