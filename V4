// ── ENHANCED calcNext → integrate sleep modifier ──────
const _origCalcNext = calcNext;
calcNext = function(hist, tMin, tMax, rpe) {
  const result = _origCalcNext(hist, tMin, tMax, rpe);
  const sleepMod = getSleepModifier();
  if(sleepMod.mod !== 1.0 && result.nextWeight) {
    // Adjust weight increment, not the base weight
    const base = hist[hist.length-1]?.weight || result.nextWeight;
    const diff = result.nextWeight - base;
    if(diff > 0) {
      result.nextWeight = Math.round((base + diff * sleepMod.mod) * 4) / 4;
    }
    if(sleepMod.note) result.note += ' ' + sleepMod.note;
  }
  return result;
};

